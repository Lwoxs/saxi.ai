{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saxi",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/health", "/internal/*"]
  }
}
